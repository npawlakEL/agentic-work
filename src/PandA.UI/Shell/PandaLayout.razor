@inherits LayoutComponentBase
@implements IDisposable
@using PandA.UI.Contracts.Common
@inject IOperatorContext Operator
@inject IServiceProvider Services

@* Design-system providers (Axon wraps MudBlazor). Order matters: theme first. *@
<MudThemeProvider @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<ElDialogProvider />
<ElSnackbarProvider />

<MudLayout data-testid="app-root" data-dark="@(_isDarkMode ? "true" : "false")">
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       data-testid="nav-toggle"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">PandA — Print &amp; Apply</MudText>
        <MudSpacer />
        <div data-testid="operator-selector" class="mr-2" style="max-width:200px">
            <MudTextField T="string"
                          Value="@Operator.CurrentOperator"
                          ValueChanged="OnOperatorChanged"
                          Immediate="true"
                          Label="Operator"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </div>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light theme" : "Switch to dark theme")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           data-testid="theme-toggle"
                           OnClick="ToggleTheme" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            @foreach (var entry in AllNavEntries)
            {
                <MudNavLink Href="@entry.Href"
                            Match="@(entry.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                            Icon="@entry.Icon">
                    @entry.Label
                </MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6" data-testid="page-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    // Core routes owned by the PandA.UI library plus any host-supplied extras (e.g. the
    // DemoHost's Line Simulator). INavExtras is optional — absent in a bare host.
    private IEnumerable<NavModel.NavEntry> AllNavEntries =>
        NavModel.Entries.Concat(
            (Services.GetService(typeof(INavExtras)) as INavExtras)?.Entries ?? []);

    protected override void OnInitialized() => Operator.OperatorChanged += OnOperatorContextChanged;

    private void OnOperatorContextChanged() => InvokeAsync(StateHasChanged);

    private void OnOperatorChanged(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            Operator.SetOperator(value);
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    public void Dispose() => Operator.OperatorChanged -= OnOperatorContextChanged;
}
