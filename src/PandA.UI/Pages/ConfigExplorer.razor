    // ---- Lane builder (step-by-step wizard) ----

    private void OpenBuilder()
    {
        _builderLane = new LineDraft { Name = "", ControlPolicy = LineControlPolicy.AllowDegraded };
        _builderPrinters = [];
        _builderStep = 0;
        _builderOpen = true;
    }

    private void BuilderCancel() => _builderOpen = false;

    private void BuilderNext()
    {
        if (string.IsNullOrWhiteSpace(_builderLane.Name))
        {
            Snackbar.Add("Enter a lane name to continue.", Severity.Warning);
            return;
        }
        _builderStep = 1;
    }

    private void BuilderBack() => _builderStep = 0;

    private void BuilderAddPrinter() =>
        _builderPrinters.Add(new PrinterDraft { Name = "New Printer", OrientationId = DefaultOrientationId(), PlcNumber = _builderPrinters.Count + 1 });

    private void BuilderRemovePrinter(PrinterDraft printer) => _builderPrinters.Remove(printer);

    private async Task BuilderFinishAsync()
    {
        if (string.IsNullOrWhiteSpace(_builderLane.Name))
        {
            Snackbar.Add("Enter a lane name to continue.", Severity.Warning);
            _builderStep = 0;
            return;
        }

        var before = _lines.Select(l => l.LineId).Where(id => id is not null).ToHashSet(StringComparer.Ordinal)!;
        var laneResult = await LineEditor.SaveAsync(_builderLane.ToDto());
        Notify(laneResult, "Lane created.");
        if (!laneResult.Success) { return; }

        var list = await LineEditor.ListAsync();
        var newId = list.FirstOrDefault(l => l.LineId is not null && !before.Contains(l.LineId))?.LineId;

        var printerFailures = 0;
        if (newId is not null)
        {
            foreach (var printer in _builderPrinters)
            {
                printer.LineId = newId;
                var result = await PrinterEditor.SaveAsync(printer.ToDto());
                if (!result.Success) { printerFailures++; }
            }
        }

        if (printerFailures > 0)
        {
            Snackbar.Add($"{printerFailures} printer(s) could not be saved.", Severity.Warning);
        }

        _builderOpen = false;
        await LoadLinesAsync(newId);
        await LoadPrintersAllAsync();
    }

