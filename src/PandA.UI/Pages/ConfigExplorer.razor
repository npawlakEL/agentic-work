    private List<FirePointDraft> FirePointsForPrinter(string? printerId)
    {
        if (string.IsNullOrWhiteSpace(printerId)) { return []; }
        // Fire points bound to this printer by any map (a fire point is shared across printers via maps).
        var ids = _allMaps
            .SelectMany(m => m.Assignments)
            .Where(a => a.PrinterIds.Contains(printerId))
            .Select(a => a.FirePointId)
            .Distinct()
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _allFirePoints.Where(f => f.Id is not null && ids.Contains(f.Id)).ToList();
    }

