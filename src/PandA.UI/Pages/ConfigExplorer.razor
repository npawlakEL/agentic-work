    private sealed class FirePointAssignmentDraft
    {
        public string FirePointId { get; set; } = "";
        public List<string> PrinterIds { get; set; } = [];
    }

    private sealed class MapDraft
    {
        public string? Id { get; set; }
        public string LineId { get; set; } = "";
        public string Name { get; set; } = "";
        public List<FirePointAssignmentDraft> Assignments { get; set; } = [];

        public int AssignedFirePointCount => Assignments.Count(a => a.PrinterIds.Count > 0);

        public bool IsAssigned(string firePointId, string printerId) =>
            Assignments.Any(a => a.FirePointId == firePointId && a.PrinterIds.Contains(printerId));

        public void SetAssigned(string firePointId, string printerId, bool on)
        {
            var a = Assignments.FirstOrDefault(x => x.FirePointId == firePointId);
            if (on)
            {
                if (a is null) { a = new FirePointAssignmentDraft { FirePointId = firePointId }; Assignments.Add(a); }
                if (!a.PrinterIds.Contains(printerId)) { a.PrinterIds.Add(printerId); }
            }
            else if (a is not null)
            {
                a.PrinterIds.Remove(printerId);
                if (a.PrinterIds.Count == 0) { Assignments.Remove(a); }
            }
        }

        public static MapDraft From(MapDto d) => new()
        {
            Id = d.MapId, LineId = d.LineId, Name = d.Name,
            Assignments = d.Assignments
                .Select(a => new FirePointAssignmentDraft { FirePointId = a.FirePointId, PrinterIds = a.PrinterIds.ToList() })
                .ToList(),
        };

        public MapDto ToDto() => new(Id, LineId, Name,
            Assignments.Where(a => a.PrinterIds.Count > 0)
                .Select(a => new FirePointAssignment(a.FirePointId, a.PrinterIds.ToList()))
                .ToList());
    }
