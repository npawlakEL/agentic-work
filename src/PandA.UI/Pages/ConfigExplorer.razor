    // ---- Per-orientation online minimums ----

    private int MinimumFor(LineDraft lane, string orientationId)
    {
        var m = lane.OnlineMinimums.FirstOrDefault(x => x.OrientationId == orientationId);
        return m?.Minimum ?? SeedMinimum(orientationId);
    }

    private void SetMinimum(LineDraft lane, string orientationId, int value)
    {
        lane.OnlineMinimums = lane.OnlineMinimums
            .Where(x => x.OrientationId != orientationId)
            .Append(new OrientationMinimum(orientationId, Math.Max(0, value)))
            .ToList();
    }

    // Seed from the label mapping: at least one online printer of that orientation on the lane.
    private int SeedMinimum(string orientationId) =>
        _printers.Any(p => p.Draft.OrientationId == orientationId) ? 1 : 0;

    // ---- Buffer order (drag-to-reorder + add/remove tags) ----

    private static void OnBufferDropped(LineDraft lane, MudItemDropInfo<string> info, MudDropContainer<string>? container)
    {
        var item = info.Item;
        if (string.IsNullOrEmpty(item)) { return; }
        lane.BufferTags.Remove(item);
        var index = Math.Clamp(info.IndexInZone, 0, lane.BufferTags.Count);
        lane.BufferTags.Insert(index, item);
        container?.Refresh();
    }

    private bool AddBufferTag(LineDraft lane, string tag, MudDropContainer<string>? container)
    {
        tag = (tag ?? string.Empty).Trim();
        if (tag.Length == 0) { return false; }
        if (lane.BufferTags.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add($"Label \"{tag}\" is already in the buffer for this lane.", Severity.Warning);
            return false;
        }
        lane.BufferTags.Add(tag);
        container?.Refresh();
        return true;
    }

    private static void RemoveBufferTag(LineDraft lane, string tag, MudDropContainer<string>? container)
    {
        lane.BufferTags.Remove(tag);
        container?.Refresh();
    }

