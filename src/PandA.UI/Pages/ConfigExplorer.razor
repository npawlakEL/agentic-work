    private async Task ApplyPrintPointToAllAsync()
    {
        if (_printers.Count == 0) { return; }
        var failures = 0;
        foreach (var item in _printers)
        {
            item.Draft.LineId = _laneId ?? item.Draft.LineId;
            item.Draft.PrintPoint = _bulkPrintPoint;
            if (!string.IsNullOrWhiteSpace(_bulkPrintDevice)) { item.Draft.PrintDevice = _bulkPrintDevice; }
            var result = await PrinterEditor.SaveAsync(item.Draft.ToDto());
            if (!result.Success) { failures++; }
        }
        if (failures > 0) { Snackbar.Add($"{failures} printer(s) could not be updated.", Severity.Warning); }
        else { Snackbar.Add("Print point applied to all printers.", Severity.Success); }
        await LoadLaneAsync(_laneId);
        await LoadPrintersAllAsync();
    }

