    private async Task LoadLinesAsync(string? prefer = null)
    {
        try
        {
            var list = await LineEditor.ListAsync();
            _lines = list.OrderBy(l => l.Name, StringComparer.Ordinal).ToList();
            var ids = _lines.Select(l => l.LineId).ToList();
            if (prefer is not null && ids.Contains(prefer)) { _laneId = prefer; }
            else if (_laneId is null || !ids.Contains(_laneId)) { _laneId = ids.FirstOrDefault(); }
            await LoadLaneAsync(_laneId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("lanes", ex); }
    }

    private async Task LoadLaneAsync(string? id)
    {
        _laneDraft = null;
        _printers = [];
        _maps = [];
        if (id is null) { return; }

        try
        {
            if (await LineEditor.GetAsync(id) is { } line) { _laneDraft = LineDraft.From(line); }
            if (_laneDraft is null) { return; }

            var printers = await PrinterEditor.ListForLineAsync(id);
            _printers = printers
                .OrderBy(p => p.PlcNumber)
                .Select(p => new PrinterEditItem { Draft = PrinterDraft.From(p) })
                .ToList();

            var maps = await MapEditor.ListForLineAsync(id);
            _maps = maps.OrderBy(m => m.Name, StringComparer.Ordinal).Select(MapDraft.From).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("lane", ex); }
    }

