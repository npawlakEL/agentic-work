    // ---- Helpers ----

    private static Color OrientationColor(string? orientation) =>
        string.Equals(orientation, "Top", StringComparison.OrdinalIgnoreCase) ? Color.Secondary : Color.Info;

    private void Notify(CommandResult result, string okFallback)
    {
        Snackbar.Add(result.Message ?? (result.Success ? okFallback : "Operation failed."),
            result.Success ? Severity.Success : Severity.Error);
    }

    private void Fail(string what, Exception ex) => Snackbar.Add($"Failed to load {what}: {ex.Message}", Severity.Error);

    private static string Join(IReadOnlyList<string> items) => string.Join(", ", items);

    private static IReadOnlyList<string> Split(string? csv)
    {
        if (string.IsNullOrWhiteSpace(csv))
        {
            return [];
        }

        // Preserve interior empty positions (buffer order / tracking devices are positional),
        // but tolerate a trailing comma by trimming only trailing empty tokens.
        var parts = csv.Split(',').Select(p => p.Trim()).ToList();
        while (parts.Count > 0 && parts[^1].Length == 0)
        {
            parts.RemoveAt(parts.Count - 1);
        }

        return parts;
    }

