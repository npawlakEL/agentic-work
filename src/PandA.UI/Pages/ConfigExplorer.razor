@page "/config"
@layout PandA.UI.Shell.PandaLayout
@using System.Globalization
@using PandA.UI.Contracts.Common
@using PandA.UI.Contracts.Config
@inject ISettingsEditor SettingsEditor
@inject ILabelDefEditor LabelEditor
@inject IMandaStationEditor StationEditor
@inject ILineEditor LineEditor
@inject IPrinterEditor PrinterEditor
@inject IFirePointEditor FirePointEditor
@inject IMapEditor MapEditor
@inject IOrientationEditor OrientationEditor
@inject ISnackbar Snackbar

<PageTitle>PandA — Config Explorer</PageTitle>

<div class="cfg-head">
    <MudText Typo="Typo.h4" data-testid="page-heading">Config Explorer</MudText>
    <MudText Typo="Typo.body2" Class="cfg-sub">Pick a lane to edit its config and printers, use Maps &amp; Fire Points to wire routing, or switch tabs to manage label definitions, stations and system settings.</MudText>
</div>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="cfg-panel" Class="cfg-tabs" data-testid="config-tabs">

    @* ---------------------------------------------------------------- Lines *@
    <MudTabPanel Text="Lines" Icon="@Icons.Material.Filled.ViewStream">
      @if (_builderOpen)
      {
        <MudPaper Elevation="0" Class="cfg-card cfg-builder" data-testid="lane-builder">
            <div class="cfg-builder-head">
                <div>
                    <MudText Typo="Typo.h6">New lane</MudText>
                    <MudText Typo="Typo.caption" Class="cfg-muted">Step @(_builderStep + 1) of 2 — @(_builderStep == 0 ? "Lane details" : "Printers")</MudText>
                </div>
                <div class="cfg-steps">
                    <span class="cfg-step @(_builderStep == 0 ? "active" : "done")">1 · Details</span>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    <span class="cfg-step @(_builderStep == 1 ? "active" : "")">2 · Printers</span>
                </div>
            </div>

            @if (_builderStep == 0)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_builderLane.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="builder-lane-name" /></MudItem>
                    <MudItem xs="12" sm="2"><MudNumericField T="int" Min="1" @bind-Value="_builderLane.PlcNumber" Label="PLC Number" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="builder-lane-plc" /></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="LineControlPolicy" @bind-Value="_builderLane.ControlPolicy" Label="Control policy" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var p in Enum.GetValues<LineControlPolicy>())
                            {
                                <MudSelectItem T="LineControlPolicy" Value="@p">@p</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField T="double" @bind-Value="_builderLane.EncoderResolutionInchesPerPulse" Label="Encoder resolution (in/pulse)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField T="double" @bind-Value="_builderLane.BeltSpeedInchesPerSecond" Label="Belt speed (in/s)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" Class="d-flex align-center gap-4">
                        <MudCheckBox T="bool" @bind-Value="_builderLane.LoadBalanceEnabled" Label="Load balancing" data-testid="builder-lane-loadbalance" />
                        <MudCheckBox T="bool" @bind-Value="_builderLane.TwoPrinterRuleEnabled" Label="Two-printer rule" data-testid="builder-lane-tworule" />
                    </MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_builderLane.Zones" Label="Zones (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Buffer order</MudText>
                        <MudText Typo="Typo.caption" Class="cfg-muted mb-2 d-block">Drag label definitions to set the order the buffer produces them. The first label is verified against the first definition, and so on.</MudText>
                        <MudDropContainer T="string" @ref="_builderBufferContainer" Items="_builderLane.BufferTags"
                                          ItemsSelector="@((i, z) => true)"
                                          ItemDropped="@(info => OnBufferDropped(_builderLane, info, _builderBufferContainer))"
                                          Class="cfg-buffer-wrap" data-testid="builder-buffer">
                            <ChildContent>
                                <MudDropZone T="string" Identifier="buffer" AllowReorder="true" Class="cfg-buffer-zone" />
                            </ChildContent>
                            <ItemRenderer>
                                <MudPaper Elevation="1" Class="cfg-buffer-item">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    <span>@context</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => RemoveBufferTag(_builderLane, context, _builderBufferContainer))" />
                                </MudPaper>
                            </ItemRenderer>
                        </MudDropContainer>
                        @if (_builderLane.BufferTags.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Class="cfg-muted">No label definitions in the buffer yet — add one below.</MudText>
                        }
                        <div class="d-flex gap-2 mt-2 align-center">
                            <MudTextField @bind-Value="_builderNewBufferTag" Label="Label definition" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="builder-buffer-newtag" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => { if (AddBufferTag(_builderLane, _builderNewBufferTag, _builderBufferContainer)) { _builderNewBufferTag = string.Empty; } })"
                                       data-testid="builder-buffer-add">Add label</MudButton>
                        </div>
                    </MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.caption" Class="cfg-muted">Per-orientation online minimums are seeded automatically and editable after the lane is created. Tracking devices are inferred from the print/apply devices.</MudText></MudItem>
                </MudGrid>
            }
            else
            {
                <div class="cfg-section-head">
                    <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="me-1" />Printers</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="BuilderAddPrinter" data-testid="builder-add-printer">Add printer</MudButton>
                </div>
                @if (_builderPrinters.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="builder-printers-empty">No printers yet. Add one, or finish to create the lane without printers.</MudText>
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                        @foreach (var bp in _builderPrinters)
                        {
                            <MudExpansionPanel Expanded="true" data-testid="builder-printer-panel">
                                <TitleContent>
                                    <div class="cfg-panel-title">
                                        <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" />
                                        <span>@(string.IsNullOrWhiteSpace(bp.Name) ? "New printer" : bp.Name)</span>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@OrientationColorById(bp.OrientationId)">@OrientationName(bp.OrientationId)</MudChip>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6"><MudTextField @bind-Value="bp.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string" @bind-Value="bp.OrientationId" Label="Orientation" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                @foreach (var o in _allOrientations)
                                                {
                                                    <MudSelectItem T="string" Value="@o.OrientationId">@o.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6"><MudTextField @bind-Value="bp.Ip" Label="IP" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="bp.Port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="3"><MudNumericField T="int" Min="1" @bind-Value="bp.PlcNumber" Label="PLC Number" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="4"><MudTextField @bind-Value="bp.PrintDevice" Label="Print device" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="4"><MudTextField @bind-Value="bp.ApplyDevice" Label="Apply device" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="bp.PrintPoint" Label="Print point" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="bp.TampMountHeightInches" Label="Tamp mount height (in)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                        <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="bp.TampSpeedInchesPerSecond" Label="Tamp speed (in/s)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    </MudGrid>
                                    <div class="cfg-actions">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="@(() => BuilderRemovePrinter(bp))" data-testid="builder-remove-printer">Remove</MudButton>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            }

            <MudDivider Class="my-4" />
            <div class="cfg-builder-actions">
                <MudButton Variant="Variant.Text" OnClick="BuilderCancel" data-testid="builder-cancel">Cancel</MudButton>
                <div class="cfg-actions-right">
                    @if (_builderStep == 1)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ChevronLeft" OnClick="BuilderBack" data-testid="builder-back">Back</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="BuilderFinishAsync" data-testid="builder-finish">Create lane</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="BuilderNext" data-testid="builder-next">Next</MudButton>
                    }
                </div>
            </div>
        </MudPaper>
      }
      else
      {
        <div class="cfg-toolbar">
            <MudSelect T="string" Label="Lane" Value="_laneId" ValueChanged="OnLaneChangedAsync"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="cfg-lane-select"
                       Disabled="@(_lines.Count == 0)" data-testid="lane-select">
                @foreach (var line in _lines)
                {
                    <MudSelectItem T="string" Value="@line.LineId">@line.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenBuilder" data-testid="add-lane">Add lane</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline"
                       OnClick="DeleteLaneAsync" Disabled="@(_laneDraft is null)" data-testid="delete-lane">Delete lane</MudButton>
        </div>

        @if (_laneDraft is null)
        {
            <div class="cfg-empty" data-testid="lane-empty">
                <MudIcon Icon="@Icons.Material.Outlined.ViewStream" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1">No lane selected</MudText>
                <MudText Typo="Typo.body2" Class="cfg-muted">Add a lane to configure its printers and fire points.</MudText>
            </div>
        }
        else
        {
            <MudPaper Elevation="0" Class="cfg-card" data-testid="lane-detail">
                <div class="cfg-card-head">
                    <div>
                        <MudText Typo="Typo.h6">@LaneTitle</MudText>
                        <MudText Typo="Typo.caption" Class="cfg-muted">@(_laneDraft.Id ?? "unsaved")</MudText>
                    </div>
                    <div class="cfg-chips">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Icon="@Icons.Material.Filled.Print">@_printers.Count printers</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Filled.Map">@_maps.Count maps</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@_laneDraft.ControlPolicy</MudChip>
                    </div>
                </div>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_laneDraft.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="lane-name" /></MudItem>
                    <MudItem xs="12" sm="2"><MudNumericField T="int" Min="1" @bind-Value="_laneDraft.PlcNumber" Label="PLC Number" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="lane-plc" /></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="LineControlPolicy" @bind-Value="_laneDraft.ControlPolicy" Label="Control policy" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var p in Enum.GetValues<LineControlPolicy>())
                            {
                                <MudSelectItem T="LineControlPolicy" Value="@p">@p</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField T="double" @bind-Value="_laneDraft.EncoderResolutionInchesPerPulse" Label="Encoder resolution (in/pulse)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField T="double" @bind-Value="_laneDraft.BeltSpeedInchesPerSecond" Label="Belt speed (in/s)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex align-center gap-4">
                        <MudCheckBox T="bool" @bind-Value="_laneDraft.LoadBalanceEnabled" Label="Load balancing" data-testid="lane-loadbalance" />
                        <MudCheckBox T="bool" @bind-Value="_laneDraft.TwoPrinterRuleEnabled" Label="Two-printer rule" data-testid="lane-tworule" />
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudTextField Value="@ActiveMapDisplay" Label="Active map (managed on Maps &amp; Fire Points)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Disabled="true" data-testid="lane-activemap" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_laneDraft.Zones" Label="Zones (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Buffer order</MudText>
                        <MudText Typo="Typo.caption" Class="cfg-muted mb-2 d-block">Drag label definitions to set the order the buffer produces them for this lane. The first label is verified against the first definition, and so on.</MudText>
                        <MudDropContainer T="string" @ref="_laneBufferContainer" Items="_laneDraft.BufferTags"
                                          ItemsSelector="@((i, z) => true)"
                                          ItemDropped="@(info => OnBufferDropped(_laneDraft, info, _laneBufferContainer))"
                                          Class="cfg-buffer-wrap" data-testid="lane-buffer">
                            <ChildContent>
                                <MudDropZone T="string" Identifier="buffer" AllowReorder="true" Class="cfg-buffer-zone" />
                            </ChildContent>
                            <ItemRenderer>
                                <MudPaper Elevation="1" Class="cfg-buffer-item">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    <span>@context</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => RemoveBufferTag(_laneDraft, context, _laneBufferContainer))" />
                                </MudPaper>
                            </ItemRenderer>
                        </MudDropContainer>
                        @if (_laneDraft.BufferTags.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Class="cfg-muted">No label definitions in the buffer yet — add one below.</MudText>
                        }
                        <div class="d-flex gap-2 mt-2 align-center">
                            <MudTextField @bind-Value="_laneNewBufferTag" Label="Label definition" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="lane-buffer-newtag" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => { if (AddBufferTag(_laneDraft, _laneNewBufferTag, _laneBufferContainer)) { _laneNewBufferTag = string.Empty; } })"
                                       data-testid="lane-buffer-add">Add label</MudButton>
                        </div>
                    </MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.caption" Class="cfg-muted">Tracking devices are inferred from each printer's print/apply devices (plus the scanner) — no manual entry needed.</MudText></MudItem>
                </MudGrid>

                @if (_laneDraft.ControlPolicy == LineControlPolicy.OnlineMinimum)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Online minimums (per orientation)</MudText>
                    <MudText Typo="Typo.caption" Class="cfg-muted">Minimum online (non-spare) printers required per orientation. Seeded from the label mapping; edit as needed.</MudText>
                    @if (_allOrientations.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty">Define orientations first (Orientations tab).</MudText>
                    }
                    else
                    {
                        <MudGrid Spacing="2" Class="mt-1" data-testid="online-minimums">
                            @foreach (var o in _allOrientations)
                            {
                                var oid = o.OrientationId!;
                                <MudItem xs="6" sm="4">
                                    <MudNumericField T="int" Min="0" Label="@($"Min — {o.Name}")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Value="MinimumFor(_laneDraft, oid)" ValueChanged="@(v => SetMinimum(_laneDraft, oid, v))" />
                                </MudItem>
                            }
                        </MudGrid>
                    }
                }

                <div class="cfg-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLaneAsync" data-testid="save-lane">Save lane</MudButton>
                </div>
            </MudPaper>

            @* ---- Printers ---- *@
            <div class="cfg-section-head">
                <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="me-1" />Printers</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddPrinter" data-testid="add-printer">Add printer</MudButton>
            </div>
            @if (_printers.Count > 0)
            {
                <MudPaper Elevation="0" Class="cfg-card" data-testid="bulk-printpoint">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Set print point / device on all printers</MudText>
                    <MudGrid Spacing="2" Class="align-center">
                        <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_bulkPrintPoint" Label="Print point" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="6" sm="4"><MudTextField @bind-Value="_bulkPrintDevice" Label="Print device (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12" sm="5">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DoneAll"
                                       OnClick="ApplyPrintPointToAllAsync" data-testid="apply-printpoint-all">Apply to all printers</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            @if (_printers.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="printers-empty">No printers on this lane yet.</MudText>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                    @foreach (var item in _printers)
                    {
                        <MudExpansionPanel data-testid="printer-panel">
                            <TitleContent>
                                <div class="cfg-panel-title">
                                    <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" />
                                    <span>@(string.IsNullOrWhiteSpace(item.Draft.Name) ? "New printer" : item.Draft.Name)</span>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@OrientationColorById(item.Draft.OrientationId)">@OrientationName(item.Draft.OrientationId)</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@FirePointsForPrinter(item.Draft.Id).Count fire points</MudChip>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="item.Draft.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" @bind-Value="item.Draft.OrientationId" Label="Orientation" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            @foreach (var o in _allOrientations)
                                            {
                                                <MudSelectItem T="string" Value="@o.OrientationId">@o.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="item.Draft.Ip" Label="IP" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="item.Draft.Port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="3"><MudNumericField T="int" Min="1" @bind-Value="item.Draft.PlcNumber" Label="PLC Number" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudTextField @bind-Value="item.Draft.PrintDevice" Label="Print device" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudTextField @bind-Value="item.Draft.ApplyDevice" Label="Apply device" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="item.Draft.PrintPoint" Label="Print point" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.TampMountHeightInches" Label="Tamp mount height (in)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.TampSpeedInchesPerSecond" Label="Tamp speed (in/s)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                </MudGrid>
                                <div class="cfg-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SavePrinterAsync(item))" data-testid="save-printer">Save printer</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeletePrinterAsync(item))" data-testid="delete-printer">Delete</MudButton>
                                </div>

                                <MudDivider Class="my-3" />

                                <div class="cfg-section-head cfg-sub-section">
                                    <MudText Typo="Typo.subtitle2"><MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" Class="me-1" />Fire points</MudText>
                                </div>
                                @{ var printerFps = FirePointsForPrinter(item.Draft.Id); }
                                @if (printerFps.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty">No fire points. Add them in the Maps &amp; Fire Points tab.</MudText>
                                }
                                else
                                {
                                    <div class="cfg-chips">
                                        @foreach (var fp in printerFps)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Icon="@Icons.Material.Filled.GpsFixed">@FirePointChipText(fp)</MudChip>
                                        }
                                    </div>
                                    <MudText Typo="Typo.caption" Class="cfg-muted">Manage fire points in the Maps &amp; Fire Points tab.</MudText>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }

        }
      }
    </MudTabPanel>

    @* --------------------------------------------- Maps & Fire points *@
    <MudTabPanel Text="Maps &amp; Fire Points" Icon="@Icons.Material.Filled.Route">
        @* ---- Maps (flat, all lines) — each expandable to its fire points, with active status ---- *@
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Class="me-1" />Maps</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddMap" Disabled="@(_lines.Count == 0)" data-testid="add-map">Add map</MudButton>
        </div>
        <MudText Typo="Typo.body2" Class="cfg-sub">Every map in the system. A map is a named set of fire points; the one set active on a line is flagged below.</MudText>
        @if (_allMaps.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="maps-empty">No maps defined yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var map in _allMaps)
                {
                    var activeOn = ActiveOnLine(map.Id);
                    <MudExpansionPanel data-testid="map-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(map.Name) ? "New map" : map.Name)</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@map.AssignedFirePointCount fire points</MudChip>
                                @if (!string.IsNullOrEmpty(activeOn))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" data-testid="map-active">Active on @activeOn</MudChip>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="map.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-Value="map.LineId" Label="Line" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="map-line">
                                        @foreach (var line in _lines)
                                        {
                                            <MudSelectItem T="string" Value="@line.LineId">@line.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            @{ var mapPrinters = PrintersOnLine(map.LineId); }
                            <MudText Typo="Typo.subtitle2" Class="mt-3">Fire point → printer assignments</MudText>
                            <MudText Typo="Typo.caption" Class="cfg-muted">Check every printer that applies each fire point. One fire point can drive several printers for redundancy.</MudText>
                            @if (_allFirePoints.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="map-nofirepoints">No fire points defined yet — add them in the Fire points glossary below.</MudText>
                            }
                            else if (mapPrinters.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="map-noprinters">Pick a line with printers to assign fire points.</MudText>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Hover="true" Class="mt-2" data-testid="map-firepoint-matrix">
                                    <thead>
                                        <tr>
                                            <th>Fire point</th>
                                            @foreach (var p in mapPrinters)
                                            {
                                                <th class="text-center">@PrinterShortLabel(p)</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var fp in _allFirePoints.Where(f => f.Id is not null))
                                        {
                                            <tr>
                                                <td>@FirePointLabel(fp)</td>
                                                @foreach (var p in mapPrinters)
                                                {
                                                    var fpId = fp.Id!;
                                                    var pid = p.PrinterId!;
                                                    <td class="text-center">
                                                        <MudCheckBox T="bool" Dense="true"
                                                                     Value="@map.IsAssigned(fpId, pid)"
                                                                     ValueChanged="@(v => map.SetAssigned(fpId, pid, v))" />
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveMapAsync(map))" data-testid="save-map">Save map</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteMapAsync(map))" data-testid="delete-map">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }

        <MudDivider Class="my-4" />

        @* ---- Fire points glossary (normalized, system-wide) ---- *@
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" Class="me-1" />Fire points</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddFirePoint" Disabled="@(_labels.Count == 0)" data-testid="add-firepoint">Add fire point</MudButton>
        </div>
        <MudText Typo="Typo.body2" Class="cfg-sub">A fire point is a label definition + apply point (edge + inches). Define it once here, then bind it to printers on a map above — the same fire point can drive several printers.</MudText>
        @if (_labels.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="firepoints-nolabels">Add a label definition first (Label Definitions tab).</MudText>
        }
        else if (_allFirePoints.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="firepoints-empty">No fire points defined yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var fp in _allFirePoints)
                {
                    <MudExpansionPanel Expanded="@(fp.Id is null)" data-testid="firepoint-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" />
                                <span>@FirePointLabel(fp)</span>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-Value="fp.LabelDefId" Label="Label definition" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="firepoint-labeldef">
                                        @foreach (var l in _labels.Where(l => l.Id is not null))
                                        {
                                            <MudSelectItem T="string" Value="@l.Id">@l.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="string" @bind-Value="fp.ApplyEdge" Label="Apply edge" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="firepoint-applyedge">
                                        <MudSelectItem T="string" Value="@("Leading")">Leading</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Middle")">Middle</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Trailing")">Trailing</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3"><MudNumericField T="double" @bind-Value="fp.ApplyInches" Label="Apply inches" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="firepoint-applyinches" /></MudItem>
                                <MudItem xs="12" Class="d-flex align-center">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">@fp.ApplyPointNotation</MudChip>
                                    <MudText Typo="Typo.caption" Class="cfg-muted ms-2">Bound to printers on the Maps above. Orientation, print/apply device and print point come from each bound printer.</MudText>
                                </MudItem>
                            </MudGrid>
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveFirePointAsync(fp))" data-testid="save-firepoint">Save fire point</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteFirePointAsync(fp))" data-testid="delete-firepoint">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @* ------------------------------------------------------- Label defs *@
    <MudTabPanel Text="Label Definitions" Icon="@Icons.Material.Filled.Label">
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1">Label definitions</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddLabel" data-testid="add-label">Add label</MudButton>
        </div>
        @if (_labels.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="labels-empty">No label definitions yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var label in _labels)
                {
                    <MudExpansionPanel Expanded="@(label.Id is null)" data-testid="label-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(label.Name) ? "New label" : label.Name)</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@label.LabelWidthInches.ToString("0.###") in</MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="label.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="label-name" /></MudItem>
                                <MudItem xs="12" sm="6"><MudNumericField T="double" @bind-Value="label.LabelWidthInches" Label="Label width (in)" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="label-width" /></MudItem>
                                <MudItem xs="12"><MudTextField @bind-Value="label.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" data-testid="label-description" /></MudItem>
                            </MudGrid>
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveLabelAsync(label))" data-testid="save-label">Save label</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteLabelAsync(label))" data-testid="delete-label">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @* --------------------------------------------------- Orientations *@
    <MudTabPanel Text="Orientations" Icon="@Icons.Material.Filled.Straighten">
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1">Apply orientations</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddOrientation" data-testid="add-orientation">Add orientation</MudButton>
        </div>
        <MudText Typo="Typo.body2" Class="cfg-sub">User-defined orientations attach to printers and fire points. The motion kind tells the simulator which applicator motion to animate (Front maps to the closest available motion for now).</MudText>
        @if (_orientations.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="orientations-empty">No orientations yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var o in _orientations)
                {
                    <MudExpansionPanel Expanded="@(o.Id is null)" data-testid="orientation-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Straighten" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(o.Name) ? "New orientation" : o.Name)</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@o.MotionKind</MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="o.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="orientation-name" /></MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="ApplyMotionKind" @bind-Value="o.MotionKind" Label="Motion kind" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="orientation-motion">
                                        @foreach (var k in Enum.GetValues<ApplyMotionKind>())
                                        {
                                            <MudSelectItem T="ApplyMotionKind" Value="@k">@k</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveOrientationAsync(o))" data-testid="save-orientation">Save orientation</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteOrientationAsync(o))" data-testid="delete-orientation">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @* --------------------------------------------------- MandA stations *@
    <MudTabPanel Text="MandA Stations" Icon="@Icons.Material.Filled.Dns">
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1">MandA stations</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddStation" data-testid="add-station">Add station</MudButton>
        </div>
        @if (_stations.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="stations-empty">No MandA stations yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var station in _stations)
                {
                    <MudExpansionPanel Expanded="@(station.Id is null)" data-testid="station-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(station.Name) ? "New station" : station.Name)</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@station.Ip:@station.Port</MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="station.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="station-name" /></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="station.Ip" Label="IP" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="station.Port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveStationAsync(station))" data-testid="save-station">Save station</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteStationAsync(station))" data-testid="delete-station">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @* -------------------------------------------------------- Settings *@
    <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
        @if (_settings is not null)
        {
            <MudPaper Elevation="0" Class="cfg-card" data-testid="settings-detail">
                <MudText Typo="Typo.h6" Class="mb-1">Global system settings</MudText>
                <MudText Typo="Typo.body2" Class="cfg-sub mb-2">These apply site-wide to every line. Changing the encoder resolution here propagates it to all lines.</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4"><MudNumericField T="double" @bind-Value="_settings.EncoderResolutionInchesPerPulse" Label="Encoder resolution (in/pulse) — global" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="_settings.VerifyFailThreshold" Label="Verify fail threshold" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="_settings.PostTripResetCount" Label="Post-trip reset count" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="_settings.ReprintLabelsEnabled" Label="Reprint labels enabled" /></MudItem>
                </MudGrid>
                <div class="cfg-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync" data-testid="save-settings">Save settings</MudButton>
                </div>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

<style>
    .cfg-head { margin-bottom: 12px; }
    .cfg-sub { color: var(--mud-palette-text-secondary); max-width: 70ch; }
    .cfg-tabs { --mud-elevation-0: none; }
    .cfg-panel { padding-top: 20px; }
    .cfg-toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 20px; }
    .cfg-lane-select { min-width: 260px; max-width: 360px; }
    .cfg-card { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; padding: 20px; margin-bottom: 8px; background: var(--mud-palette-surface); }
    .cfg-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .cfg-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .cfg-section-head { display: flex; justify-content: space-between; align-items: center; margin: 24px 0 10px; }
    .cfg-sub-section { margin: 8px 0 6px; }
    .cfg-panels { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; overflow: hidden; }
    .cfg-panel-title { display: flex; align-items: center; gap: 10px; }
    .cfg-firepoint { border: 1px solid var(--mud-palette-lines-default); border-radius: 10px; padding: 12px; margin-bottom: 10px; background: var(--mud-palette-background-gray); }
    .cfg-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
    .cfg-actions-tight { margin-top: 0; }
    .cfg-muted { color: var(--mud-palette-text-secondary); }
    .cfg-inline-empty { padding: 12px 4px; }
    .cfg-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 48px 16px; color: var(--mud-palette-text-secondary); text-align: center; }
    .cfg-builder-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .cfg-steps { display: flex; align-items: center; gap: 8px; }
    .cfg-step { font-size: 0.8rem; font-weight: 600; padding: 4px 12px; border-radius: 999px; color: var(--mud-palette-text-secondary); background: var(--mud-palette-background-gray); border: 1px solid var(--mud-palette-lines-default); }
    .cfg-step.active { color: var(--mud-palette-primary-text); background: var(--mud-palette-primary); border-color: var(--mud-palette-primary); }
    .cfg-step.done { color: var(--mud-palette-success); border-color: var(--mud-palette-success); background: transparent; }
    .cfg-builder-actions { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 16px; }
    .cfg-actions-right { display: flex; gap: 8px; }
    .cfg-buffer-wrap { margin-top: 4px; }
    .cfg-buffer-zone { display: flex; flex-wrap: wrap; gap: 8px; min-height: 52px; padding: 10px; border: 1px dashed var(--mud-palette-lines-default); border-radius: 8px; background: var(--mud-palette-background-gray); }
    .cfg-buffer-item { display: inline-flex; align-items: center; gap: 6px; padding: 4px 6px 4px 10px; border-radius: 999px; cursor: grab; user-select: none; background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default); }
    .cfg-buffer-item:active { cursor: grabbing; }
    .mud-drop-item-preview { opacity: 0.5; }
</style>

@code {
    private List<LineDto> _lines = [];
    private string? _laneId;
    private LineDraft? _laneDraft;
    private List<PrinterEditItem> _printers = [];
    private List<MapDraft> _maps = [];

    private List<PrinterDto> _allPrinters = [];
    private List<FirePointDraft> _allFirePoints = [];
    private List<MapDraft> _allMaps = [];

    private List<OrientationDto> _allOrientations = [];
    private List<OrientationDraft> _orientations = [];

    private List<LabelDraft> _labels = [];
    private List<StationDraft> _stations = [];
    private SettingsDraft? _settings;

    // Line-level bulk print-point action.
    private int _bulkPrintPoint;
    private string _bulkPrintDevice = "";

    // Buffer-order drag/drop editors (one for the current lane, one for the builder wizard).
    private MudDropContainer<string>? _laneBufferContainer;
    private MudDropContainer<string>? _builderBufferContainer;
    private string _laneNewBufferTag = "";
    private string _builderNewBufferTag = "";

    // Lane builder (step-by-step wizard) state.
    private bool _builderOpen;
    private int _builderStep;
    private LineDraft _builderLane = new();
    private List<PrinterDraft> _builderPrinters = [];

    private string LaneTitle => string.IsNullOrWhiteSpace(_laneDraft?.Name) ? "Untitled lane" : _laneDraft!.Name;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrientationsAsync();
        await LoadLabelsAsync();
        await LoadLinesAsync();
        await LoadPrintersAllAsync();
        await LoadFirePointsAllAsync();
        await LoadMapsAllAsync();
        await LoadStationsAsync();
        await LoadSettingsAsync();
    }

    // ---- Loading ----

    private async Task LoadOrientationsAsync()
    {
        try
        {
            var list = await OrientationEditor.ListAsync();
            _allOrientations = list.OrderBy(o => o.Name, StringComparer.Ordinal).ToList();
            _orientations = _allOrientations.Select(OrientationDraft.From).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("orientations", ex); }
    }

    private async Task LoadMapsAllAsync()
    {
        try
        {
            var list = await MapEditor.ListAsync();
            _allMaps = list.OrderBy(m => m.Name, StringComparer.Ordinal).Select(MapDraft.From).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("maps", ex); }
    }

    private async Task LoadSettingsAsync()
    {
        try { _settings = SettingsDraft.From(await SettingsEditor.GetAsync()); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("settings", ex); }
    }

    private async Task LoadLabelsAsync()
    {
        try
        {
            var list = await LabelEditor.ListAsync();
            _labels = list.OrderBy(l => l.Name, StringComparer.Ordinal).Select(LabelDraft.From).ToList();
        }
