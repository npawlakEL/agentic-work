@page "/config"
@layout PandA.UI.Shell.PandaLayout
@using System.Globalization
@using PandA.UI.Contracts.Common
@using PandA.UI.Contracts.Config
@inject ISettingsEditor SettingsEditor
@inject ILabelDefEditor LabelEditor
@inject IMandaStationEditor StationEditor
@inject ILineEditor LineEditor
@inject IPrinterEditor PrinterEditor
@inject IFirePointEditor FirePointEditor
@inject IMapEditor MapEditor
@inject ISnackbar Snackbar

<PageTitle>PandA — Config Explorer</PageTitle>

<div class="cfg-head">
    <MudText Typo="Typo.h4" data-testid="page-heading">Config Explorer</MudText>
    <MudText Typo="Typo.body2" Class="cfg-sub">Pick a lane to edit its config, printers, fire points and maps, or switch tabs to manage label definitions, stations and system settings.</MudText>
</div>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="cfg-panel" Class="cfg-tabs" data-testid="config-tabs">

    @* ---------------------------------------------------------------- Lines *@
    <MudTabPanel Text="Lines" Icon="@Icons.Material.Filled.ViewStream">
        <div class="cfg-toolbar">
            <MudSelect T="string" Label="Lane" Value="_laneId" ValueChanged="OnLaneChangedAsync"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="cfg-lane-select"
                       Disabled="@(_lines.Count == 0)" data-testid="lane-select">
                @foreach (var line in _lines)
                {
                    <MudSelectItem T="string" Value="@line.LineId">@line.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddLaneAsync" data-testid="add-lane">Add lane</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline"
                       OnClick="DeleteLaneAsync" Disabled="@(_laneDraft is null)" data-testid="delete-lane">Delete lane</MudButton>
        </div>

        @if (_laneDraft is null)
        {
            <div class="cfg-empty" data-testid="lane-empty">
                <MudIcon Icon="@Icons.Material.Outlined.ViewStream" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1">No lane selected</MudText>
                <MudText Typo="Typo.body2" Class="cfg-muted">Add a lane to configure its printers and fire points.</MudText>
            </div>
        }
        else
        {
            <MudPaper Elevation="0" Class="cfg-card" data-testid="lane-detail">
                <div class="cfg-card-head">
                    <div>
                        <MudText Typo="Typo.h6">@LaneTitle</MudText>
                        <MudText Typo="Typo.caption" Class="cfg-muted">@(_laneDraft.Id ?? "unsaved")</MudText>
                    </div>
                    <div class="cfg-chips">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Icon="@Icons.Material.Filled.Print">@_printers.Count printers</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Filled.Map">@_maps.Count maps</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@_laneDraft.ControlPolicy</MudChip>
                    </div>
                </div>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_laneDraft.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="lane-name" /></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="LineControlPolicy" @bind-Value="_laneDraft.ControlPolicy" Label="Control policy" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var p in Enum.GetValues<LineControlPolicy>())
                            {
                                <MudSelectItem T="LineControlPolicy" Value="@p">@p</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="_laneDraft.OnlineMinimum" Label="Online minimum" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_laneDraft.ActiveMapId" Label="Active map id" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_laneDraft.Zones" Label="Zones (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_laneDraft.TrackingDevices" Label="Tracking devices (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_laneDraft.BufferOrder" Label="Buffer order (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                </MudGrid>
                <div class="cfg-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLaneAsync" data-testid="save-lane">Save lane</MudButton>
                </div>
            </MudPaper>

            @* ---- Printers ---- *@
            <div class="cfg-section-head">
                <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="me-1" />Printers</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddPrinter" data-testid="add-printer">Add printer</MudButton>
            </div>
            @if (_printers.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="printers-empty">No printers on this lane yet.</MudText>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                    @foreach (var item in _printers)
                    {
                        <MudExpansionPanel data-testid="printer-panel">
                            <TitleContent>
                                <div class="cfg-panel-title">
                                    <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" />
                                    <span>@(string.IsNullOrWhiteSpace(item.Draft.Name) ? "New printer" : item.Draft.Name)</span>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@OrientationColor(item.Draft.Orientation)">@item.Draft.Orientation</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@item.FirePoints.Count fire points</MudChip>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="item.Draft.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" @bind-Value="item.Draft.Orientation" Label="Orientation" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem T="string" Value="@("Side")">Side</MudSelectItem>
                                            <MudSelectItem T="string" Value="@("Top")">Top</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="item.Draft.Ip" Label="IP" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="item.Draft.Port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="item.Draft.ConfigOrder" Label="Config order" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12"><MudTextField @bind-Value="item.Draft.LabelTypes" Label="Label types (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.LabelWidthInches" Label="Label width (in)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.TampMountHeightInches" Label="Tamp mount height (in)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.EncoderResolutionInchesPerPulse" Label="Encoder res (in/pulse)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.BeltSpeedInchesPerSecond" Label="Belt speed (in/s)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" sm="4"><MudNumericField T="double" @bind-Value="item.Draft.TampSpeedInchesPerSecond" Label="Tamp speed (in/s)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="item.Draft.SpareEligible" Label="Spare eligible" /></MudItem>
                                </MudGrid>
                                <div class="cfg-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SavePrinterAsync(item))" data-testid="save-printer">Save printer</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeletePrinterAsync(item))" data-testid="delete-printer">Delete</MudButton>
                                </div>

                                <MudDivider Class="my-3" />

                                <div class="cfg-section-head cfg-sub-section">
                                    <MudText Typo="Typo.subtitle2"><MudIcon Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small" Class="me-1" />Fire points</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                               Disabled="@(item.Draft.Id is null)" OnClick="@(() => AddFirePoint(item))" data-testid="add-firepoint">Add fire point</MudButton>
                                </div>
                                @if (item.Draft.Id is null)
                                {
                                    <MudText Typo="Typo.caption" Class="cfg-muted">Save the printer first to add fire points.</MudText>
                                }
                                else if (item.FirePoints.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty">No fire points configured.</MudText>
                                }
                                else
                                {
                                    @foreach (var fp in item.FirePoints)
                                    {
                                        <div class="cfg-firepoint" data-testid="firepoint-row">
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="fp.LabelType" Label="Label type" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="fp.ApplyPointNotation" Label="Apply point (1T, 1L, 0M)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="fp.PrintPoint" Label="Print point" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="fp.PrintTrackingDevice" Label="Print tracking device" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="firepoint-printtd" /></MudItem>
                                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="fp.ApplyTrackingDevice" Label="Apply tracking device" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="12" Class="d-flex align-center justify-space-between">
                                                    <MudCheckBox T="bool" @bind-Value="fp.DynamicApply" Label="Dynamic apply" />
                                                    <div class="cfg-actions cfg-actions-tight">
                                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveFirePointAsync(fp))" data-testid="save-firepoint">Save</MudButton>
                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteFirePointAsync(item, fp))" data-testid="delete-firepoint">Delete</MudButton>
                                                    </div>
                                                </MudItem>
                                            </MudGrid>
                                        </div>
                                    }
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }

            @* ---- Maps ---- *@
            <div class="cfg-section-head">
                <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Class="me-1" />Maps</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddMap" data-testid="add-map">Add map</MudButton>
            </div>
            @if (_maps.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="maps-empty">No maps on this lane yet.</MudText>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                    @foreach (var map in _maps)
                    {
                        <MudExpansionPanel data-testid="map-panel">
                            <TitleContent>
                                <div class="cfg-panel-title">
                                    <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                                    <span>@(string.IsNullOrWhiteSpace(map.Name) ? "New map" : map.Name)</span>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="map.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12"><MudTextField @bind-Value="map.FirePointIds" Label="Fire point ids (comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                </MudGrid>
                                <div class="cfg-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveMapAsync(map))" data-testid="save-map">Save map</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteMapAsync(map))" data-testid="delete-map">Delete</MudButton>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        }
    </MudTabPanel>

    @* ------------------------------------------------------- Label defs *@
    <MudTabPanel Text="Label Definitions" Icon="@Icons.Material.Filled.Label">
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1">Label definitions</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddLabel" data-testid="add-label">Add label</MudButton>
        </div>
        @if (_labels.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="labels-empty">No label definitions yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var label in _labels)
                {
                    <MudExpansionPanel Expanded="@(label.Id is null)" data-testid="label-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(label.Name) ? "New label" : label.Name)</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@OrientationColor(label.Orientation)">@label.Orientation</MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="label.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="label-name" /></MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="string" @bind-Value="label.Orientation" Label="Orientation" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="string" Value="@("Side")">Side</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Top")">Top</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="label.PrintPosition" Label="Print position" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveLabelAsync(label))" data-testid="save-label">Save label</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteLabelAsync(label))" data-testid="delete-label">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @* --------------------------------------------------- MandA stations *@
    <MudTabPanel Text="MandA Stations" Icon="@Icons.Material.Filled.Dns">
        <div class="cfg-section-head">
            <MudText Typo="Typo.subtitle1">MandA stations</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddStation" data-testid="add-station">Add station</MudButton>
        </div>
        @if (_stations.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cfg-muted cfg-inline-empty" data-testid="stations-empty">No MandA stations yet.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="cfg-panels">
                @foreach (var station in _stations)
                {
                    <MudExpansionPanel Expanded="@(station.Id is null)" data-testid="station-panel">
                        <TitleContent>
                            <div class="cfg-panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(station.Name) ? "New station" : station.Name)</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@station.Ip:@station.Port</MudChip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="station.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="station-name" /></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="station.Ip" Label="IP" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="station.Port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                            <div class="cfg-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveStationAsync(station))" data-testid="save-station">Save station</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteStationAsync(station))" data-testid="delete-station">Delete</MudButton>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @* -------------------------------------------------------- Settings *@
    <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
        @if (_settings is not null)
        {
            <MudPaper Elevation="0" Class="cfg-card" data-testid="settings-detail">
                <MudText Typo="Typo.h6" Class="mb-2">System settings</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4"><MudNumericField T="double" @bind-Value="_settings.EncoderResolutionInchesPerPulse" Label="Encoder resolution (in/pulse)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="_settings.VerifyFailThreshold" Label="Verify fail threshold" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="_settings.PostTripResetCount" Label="Post-trip reset count" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="_settings.ReprintLabelsEnabled" Label="Reprint labels enabled" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="_settings.LoadBalanceEnabled" Label="Load balancing" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="_settings.TwoPrinterRuleEnabled" Label="Two-printer rule" /></MudItem>
                </MudGrid>
                <div class="cfg-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync" data-testid="save-settings">Save settings</MudButton>
                </div>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

<style>
    .cfg-head { margin-bottom: 12px; }
    .cfg-sub { color: var(--mud-palette-text-secondary); max-width: 70ch; }
    .cfg-tabs { --mud-elevation-0: none; }
    .cfg-panel { padding-top: 20px; }
    .cfg-toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 20px; }
    .cfg-lane-select { min-width: 260px; max-width: 360px; }
    .cfg-card { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; padding: 20px; margin-bottom: 8px; background: var(--mud-palette-surface); }
    .cfg-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .cfg-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .cfg-section-head { display: flex; justify-content: space-between; align-items: center; margin: 24px 0 10px; }
    .cfg-sub-section { margin: 8px 0 6px; }
    .cfg-panels { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; overflow: hidden; }
    .cfg-panel-title { display: flex; align-items: center; gap: 10px; }
    .cfg-firepoint { border: 1px solid var(--mud-palette-lines-default); border-radius: 10px; padding: 12px; margin-bottom: 10px; background: var(--mud-palette-background-gray); }
    .cfg-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
    .cfg-actions-tight { margin-top: 0; }
    .cfg-muted { color: var(--mud-palette-text-secondary); }
    .cfg-inline-empty { padding: 12px 4px; }
    .cfg-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 48px 16px; color: var(--mud-palette-text-secondary); text-align: center; }
</style>

@code {
    private List<LineDto> _lines = [];
    private string? _laneId;
    private LineDraft? _laneDraft;
    private List<PrinterEditItem> _printers = [];
    private List<MapDraft> _maps = [];

    private List<LabelDraft> _labels = [];
    private List<StationDraft> _stations = [];
    private SettingsDraft? _settings;

    private string LaneTitle => string.IsNullOrWhiteSpace(_laneDraft?.Name) ? "Untitled lane" : _laneDraft!.Name;

    protected override async Task OnInitializedAsync()
    {
        await LoadLinesAsync();
        await LoadLabelsAsync();
        await LoadStationsAsync();
        await LoadSettingsAsync();
    }

    // ---- Loading ----

    private async Task LoadSettingsAsync()
    {
        try { _settings = SettingsDraft.From(await SettingsEditor.GetAsync()); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("settings", ex); }
    }

    private async Task LoadLabelsAsync()
    {
        try
        {
            var list = await LabelEditor.ListAsync();
            _labels = list.OrderBy(l => l.Name, StringComparer.Ordinal).Select(LabelDraft.From).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("labels", ex); }
    }

    private async Task LoadStationsAsync()
    {
        try
        {
            var list = await StationEditor.ListAsync();
            _stations = list.OrderBy(s => s.Name, StringComparer.Ordinal).Select(StationDraft.From).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("stations", ex); }
    }

    private async Task LoadLinesAsync(string? prefer = null)
    {
        try
        {
            var list = await LineEditor.ListAsync();
            _lines = list.OrderBy(l => l.Name, StringComparer.Ordinal).ToList();
            var ids = _lines.Select(l => l.LineId).ToList();
            if (prefer is not null && ids.Contains(prefer)) { _laneId = prefer; }
            else if (_laneId is null || !ids.Contains(_laneId)) { _laneId = ids.FirstOrDefault(); }
            await LoadLaneAsync(_laneId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("lanes", ex); }
    }

    private async Task LoadLaneAsync(string? id)
    {
        _laneDraft = null;
        _printers = [];
        _maps = [];
        if (id is null) { return; }

        try
        {
            if (await LineEditor.GetAsync(id) is { } line) { _laneDraft = LineDraft.From(line); }
            if (_laneDraft is null) { return; }

            var printers = await PrinterEditor.ListForLineAsync(id);
            var items = new List<PrinterEditItem>();
            foreach (var p in printers.OrderBy(p => p.ConfigOrder))
            {
                var fps = p.PrinterId is { } pid
                    ? await FirePointEditor.ListForPrinterAsync(pid)
                    : (IReadOnlyList<FirePointDto>)[];
                items.Add(new PrinterEditItem
                {
                    Draft = PrinterDraft.From(p),
                    FirePoints = fps.OrderBy(f => f.LabelType, StringComparer.Ordinal).Select(FirePointDraft.From).ToList(),
                });
            }
            _printers = items;

            var maps = await MapEditor.ListForLineAsync(id);
            _maps = maps.OrderBy(m => m.Name, StringComparer.Ordinal).Select(MapDraft.From).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail("lane", ex); }
    }

    // ---- Lanes ----

    private async Task OnLaneChangedAsync(string? id)
    {
        _laneId = id;
        await LoadLaneAsync(id);
    }

    private async Task AddLaneAsync()
    {
        var before = _lines.Select(l => l.LineId).Where(id => id is not null).ToHashSet(StringComparer.Ordinal)!;
        var result = await LineEditor.SaveAsync(new LineDraft { Name = "New Lane" }.ToDto());
        Notify(result, "Lane added.");
        if (result.Success)
        {
            var list = await LineEditor.ListAsync();
            var added = list.FirstOrDefault(l => l.LineId is not null && !before.Contains(l.LineId));
            await LoadLinesAsync(added?.LineId);
        }
    }

    private async Task DeleteLaneAsync()
    {
        if (_laneId is null) { return; }
        var result = await LineEditor.DeleteAsync(_laneId);
        Notify(result, "Lane deleted.");
        if (result.Success) { _laneId = null; await LoadLinesAsync(); }
    }

    private async Task SaveLaneAsync()
