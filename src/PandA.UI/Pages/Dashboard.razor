@page "/"
@layout PandA.UI.Shell.PandaLayout
@using PandA.UI.Contracts.Status
@implements IAsyncDisposable
@inject ILineStatusStream LineStream
@inject IPrinterStatusStream PrinterStream

<PageTitle>PandA — Dashboard</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" data-testid="page-heading">Dashboard</MudText>
<MudText Typo="Typo.body1" Class="mb-4">Live health of every line and its printers. Updates in real time.</MudText>

@foreach (var line in _lines)
{
    var linePrinters = PrintersFor(line.LineId);
    <MudPaper Elevation="2" Class="mb-4 pa-0" data-testid="line-card">
        <div class="line-head">
            <div>
                <MudText Typo="Typo.h6">@line.Name</MudText>
                <MudText Typo="Typo.caption" Class="dash-muted">Map: @line.ActiveMapName</MudText>
            </div>
            <div class="line-head-meta">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Print">@line.OnlinePrinterCount / @line.PrinterCount online</MudChip>
                @if (!string.IsNullOrEmpty(line.Reason))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">@line.Reason</MudChip>
                }
                <MudChip T="string" Color="@LineColor(line.RunState)" Size="Size.Small">@line.RunState</MudChip>
            </div>
        </div>

        @if (linePrinters.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="dash-muted pa-4" data-testid="line-no-printers">No printers configured on this line.</MudText>
        }
        else
        {
            <MudTable Items="linePrinters" Dense="true" Hover="true" Elevation="0" Class="line-printers" data-testid="printer-table">
                <HeaderContent>
                    <MudTh>Printer</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>Orientation</MudTh>
                    <MudTh>Verify Fails</MudTh>
                    <MudTh>Label Types</MudTh>
                    <MudTh>Last Printed</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Printer">@context.Name</MudTd>
                    <MudTd DataLabel="State">
                        <MudChip T="string" Size="Size.Small" Color="@PrinterColor(context)">@PrinterStateText(context)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Orientation">@context.Orientation</MudTd>
                    <MudTd DataLabel="Verify Fails">@context.VerifyFailCount / @context.VerifyFailThreshold</MudTd>
                    <MudTd DataLabel="Label Types">@string.Join(", ", context.LabelTypes)</MudTd>
                    <MudTd DataLabel="Last Printed">@(context.LastPrintedUtc?.LocalDateTime.ToString("HH:mm:ss") ?? "—")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

<style>
    .line-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; border-bottom: 1px solid var(--mud-palette-lines-default); flex-wrap: wrap; }
    .line-head-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .line-printers { padding: 4px 8px 8px; }
    .dash-muted { color: var(--mud-palette-text-secondary); }
</style>

@code {
    private IReadOnlyList<LineStatus> _lines = [];
    private IReadOnlyList<PrinterStatus> _printers = [];
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _lines = await LineStream.GetSnapshotAsync(_cts.Token);
        _printers = await PrinterStream.GetSnapshotAsync(_cts.Token);

        _ = ConsumeLinesAsync();
        _ = ConsumePrintersAsync();
    }

    private async Task ConsumeLinesAsync()
    {
        try
        {
            await foreach (var update in LineStream.SubscribeAsync(_cts.Token))
            {
                _lines = _lines.Select(l => string.Equals(l.LineId, update.LineId, StringComparison.Ordinal) ? update : l).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // shutting down
        }
    }

    private async Task ConsumePrintersAsync()
    {
        try
        {
            await foreach (var update in PrinterStream.SubscribeAsync(_cts.Token))
            {
                _printers = _printers.Select(p => string.Equals(p.PrinterId, update.PrinterId, StringComparison.Ordinal) ? update : p).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // shutting down
        }
    }

    private static Color LineColor(LineRunState state) => state switch
    {
        LineRunState.Running => Color.Success,
        LineRunState.Slow => Color.Warning,
        _ => Color.Error,
    };

    private IReadOnlyList<PrinterStatus> PrintersFor(string lineId) =>
        _printers
            .Where(p => string.Equals(p.LineId, lineId, StringComparison.Ordinal))
            .OrderBy(p => p.Name, StringComparer.Ordinal)
            .ToList();

    private static Color PrinterColor(PrinterStatus p) =>
        !p.Online ? Color.Error : p.IsSpare ? Color.Info : Color.Success;

    private static string PrinterStateText(PrinterStatus p) =>
        !p.Online ? "Offline" : p.IsSpare ? "Spare" : "Online";

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
